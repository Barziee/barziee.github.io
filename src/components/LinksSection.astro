---
import { site } from "../data/site";

// The reference pattern: accent-filled rounded squares, one near-black
// monochrome glyph, 52px so they clear the 44px target. Plain text links sit
// below them for anyone who wants to read the URL — the glyph never carries
// the meaning alone.
const chips = [
  {
    label: "email",
    href: `mailto:${site.contact.email}`,
    text: site.contact.email,
    d: "M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11Zm2.2.5 6.8 5.2L18.8 7H5.2Z",
  },
  {
    label: "LinkedIn",
    href: site.contact.linkedin,
    text: site.contact.linkedin.replace(/^https?:\/\/(www\.)?/, ""),
    d: "M4.98 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95C21.4 8.75 22 11 22 14v7h-4v-6.2c0-1.5-.03-3.4-2.1-3.4-2.1 0-2.4 1.6-2.4 3.3V21h-4V9Z",
  },
  {
    label: "GitHub",
    href: site.contact.github,
    text: site.contact.github.replace(/^https?:\/\/(www\.)?/, ""),
    d: "M12 2a10 10 0 0 0-3.16 19.5c.5.08.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.57.69.48A10 10 0 0 0 12 2Z",
  },
  {
    label: "resume",
    href: site.resume,
    text: null,
    d: "M6 2h9l5 5v15H6V2Zm8 1.5V8h4.5L14 3.5ZM8.5 12h7v1.6h-7V12Zm0 3.4h7V17h-7v-1.6Z",
  },
];
---

<section id="links" class="scroll-mt-24 px-4 py-16 md:py-24">
  <div class="mx-auto max-w-2xl">
    <div class="rounded-tile bg-card p-6 md:p-8">
      <h2 class="font-display text-3xl md:text-4xl">CV &amp; links</h2>

      <a
        href={site.resume}
        class="pill-solid mt-6 block rounded-chip bg-citrus px-6 py-3 text-center font-display text-base font-extrabold !text-on-accent"
      >
        &darr; Download r&eacute;sum&eacute; (PDF)
      </a>

      <ul class="mt-6 flex flex-wrap gap-3">
        {
          chips.map((c) => (
            <li class="flex flex-col items-center gap-1">
              <a
                href={c.href}
                target={c.href.startsWith("http") ? "_blank" : undefined}
                rel={c.href.startsWith("http") ? "noopener noreferrer" : undefined}
                aria-label={c.label}
                class="grid h-13 w-13 place-items-center rounded-xl bg-citrus !text-on-accent transition-transform duration-[var(--dur-base)] ease-spring hover:-translate-y-0.5"
                style="height:52px;width:52px"
              >
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
                  <path d={c.d} />
                </svg>
              </a>
              <span class="text-[11px] text-ink-3">{c.label}</span>
            </li>
          ))
        }
      </ul>

      <ul class="mt-6 flex flex-col gap-2 border-t border-line pt-5">
        {
          chips
            .filter((c) => c.text)
            .map((c) => (
              <li>
                <a
                  href={c.href}
                  target={c.href.startsWith("http") ? "_blank" : undefined}
                  rel={c.href.startsWith("http") ? "noopener noreferrer" : undefined}
                  class="inline-flex min-h-6 items-center py-1 text-sm !text-ink-2 transition-colors duration-[var(--dur-fast)] ease-out-soft hover:!text-citrus"
                >
                  {c.text}
                </a>
              </li>
            ))
        }
      </ul>
    </div>
  </div>
</section>

<footer class="border-t border-line">
  <p class="mx-auto max-w-6xl px-4 py-8 text-center text-xs text-ink-3">
    {site.name} &mdash; {site.role}
  </p>
</footer>
