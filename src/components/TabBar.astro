---
const tabs = [
  { id: "start", label: "start" },
  { id: "games", label: "games" },
  { id: "links", label: "cv & links" },
];

const links = [
  { label: "Email", href: "mailto:barzie02@gmail.com", d: "M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11Zm2.2.5 6.8 5.2L18.8 7H5.2Z" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/bar-ronen", d: "M4.98 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95C21.4 8.75 22 11 22 14v7h-4v-6.2c0-1.5-.03-3.4-2.1-3.4-2.1 0-2.4 1.6-2.4 3.3V21h-4V9Z" },
  { label: "GitHub", href: "https://github.com/Barziee", d: "M12 2a10 10 0 0 0-3.16 19.5c.5.08.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.57.69.48A10 10 0 0 0 12 2Z" },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-page/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3 md:px-6">
    <!-- Wordmark: desktop only; on mobile the tab bar owns the width. -->
    <a href="#start" class="hidden min-h-11 shrink-0 items-center font-display text-lg font-extrabold !text-ink md:flex">
      bar ronen
    </a>

    <!-- HUD tab bar. The citrus puck springs between sections. -->
    <nav aria-label="Sections" class="mx-auto">
      <ul
        id="hud"
        class="relative flex items-center gap-1 rounded-chip bg-section p-1.5"
      >
        <span
          id="puck"
          aria-hidden="true"
          class="pointer-events-none absolute left-0 top-1.5 bottom-1.5 rounded-chip bg-citrus"
          style="width:0;transform:translateX(0);transition:transform 420ms var(--ease-spring),width 420ms var(--ease-spring)"
        ></span>
        {
          tabs.map((t) => (
            <li class="relative z-10">
              <a
                href={`#${t.id}`}
                data-tab={t.id}
                class="flex min-h-11 items-center rounded-chip px-3.5 py-2.5 text-sm font-semibold !text-ink-2 transition-colors duration-[var(--dur-fast)] ease-out-soft hover:!text-ink aria-[current=true]:!text-on-accent md:px-4"
              >
                {t.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Icon chips: accent-filled rounded squares, near-black glyph, 44px+. -->
    <div class="ml-auto hidden items-center gap-2 md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            target={l.href.startsWith("http") ? "_blank" : undefined}
            rel={l.href.startsWith("http") ? "noopener noreferrer" : undefined}
            aria-label={l.label}
            title={l.label}
            class="grid h-11 w-11 place-items-center rounded-xl bg-citrus !text-on-accent transition-transform duration-[var(--dur-base)] ease-spring hover:-translate-y-0.5"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
              <path d={l.d} />
            </svg>
          </a>
        ))
      }
    </div>

    <button
      id="motion-toggle"
      type="button"
      aria-pressed="false"
      class="min-h-11 shrink-0 rounded-chip border border-line px-3.5 py-2.5 text-xs font-semibold text-ink-3 transition-colors duration-[var(--dur-fast)] ease-out-soft hover:border-ink-3 hover:text-ink"
    >
      <span data-motion-label>Pause motion</span>
    </button>
  </div>
</header>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-tab]")];
  const sections = links
    .map((l) => document.getElementById(l.dataset.tab!))
    .filter((el): el is HTMLElement => Boolean(el));
  const puck = document.getElementById("puck");

  if (sections.length && puck) {
    // The puck is the only thing that marks the active tab, so it has to land
    // exactly on the label rather than approximately.
    const movePuck = (el: HTMLElement) => {
      const parent = el.closest("li") as HTMLElement;
      puck.style.width = `${parent.offsetWidth}px`;
      puck.style.transform = `translateX(${parent.offsetLeft}px)`;
    };

    const setCurrent = (id: string) => {
      links.forEach((l) => {
        const on = l.dataset.tab === id;
        l.setAttribute("aria-current", String(on));
        if (on) movePuck(l);
      });
    };

    // Active section straight from scroll position. A centre-band
    // IntersectionObserver can never activate a short final section.
    const OFFSET = 96;
    const activeId = () => {
      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
        return sections[sections.length - 1].id;
      }
      const y = window.scrollY + OFFSET + 1;
      let current = sections[0].id;
      for (const s of sections) if (s.offsetTop <= y) current = s.id;
      return current;
    };

    let queued = false;
    const update = () => {
      queued = false;
      setCurrent(activeId());
    };
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });

    // Skip the spring on the very first placement — the puck should start
    // under the active tab, not fly to it on load.
    const prev = puck.style.transition;
    puck.style.transition = "none";
    update();
    requestAnimationFrame(() => {
      puck.style.transition = prev;
    });

    // Scroll on click explicitly rather than leaning on default anchor
    // behaviour, so the offset clears the sticky bar and the puck lands on the
    // new tab immediately instead of waiting for the scroll to settle.
    links.forEach((l) =>
      l.addEventListener("click", (e) => {
        const target = document.getElementById(l.dataset.tab!);
        if (!target) return;
        e.preventDefault();
        const reduce =
          document.documentElement.dataset.motion === "off" ||
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        window.scrollTo({
          top: Math.max(0, target.offsetTop - OFFSET + 8),
          behavior: reduce ? "instant" : "smooth",
        });
        history.replaceState(null, "", "#" + l.dataset.tab);
        setCurrent(l.dataset.tab!);
      }),
    );

    document.fonts?.ready.then(update);
    (window as any).__activeTab = activeId;
  }

  // --- Motion toggle --------------------------------------------------------
  const btn = document.getElementById("motion-toggle");
  const label = btn?.querySelector("[data-motion-label]");

  const render = (off: boolean) => {
    document.documentElement.dataset.motion = off ? "off" : "on";
    btn?.setAttribute("aria-pressed", String(off));
    if (label) label.textContent = off ? "Resume motion" : "Pause motion";
    try {
      localStorage.setItem("motion", off ? "off" : "on");
    } catch (e) {
      /* storage blocked — the toggle still works for this page view */
    }
  };

  let stored: string | null = null;
  try {
    stored = localStorage.getItem("motion");
  } catch (e) {
    /* ignore */
  }
  render(stored ? stored === "off" : window.matchMedia("(prefers-reduced-motion: reduce)").matches);
  btn?.addEventListener("click", () => render(document.documentElement.dataset.motion !== "off"));
</script>
